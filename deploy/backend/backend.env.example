# copy to /etc/edict/backend.env before enabling systemd units
# fill secrets before first start

EDICT_BACKEND_VENV=/root/.openclaw/workspace/edict/.venv-edict-backend
EDICT_BACKEND_ENV_FILE=/etc/edict/backend.env
OPENCLAW_PROJECT_DIR=/root/.openclaw/workspace/edict
EDICT_HOME=/root/.openclaw/workspace/edict
OPENCLAW_BIN=openclaw

BACKEND_HOST=127.0.0.1
BACKEND_PORT=18000
PORT=18000

EDICT_PG_DB=edict
EDICT_PG_USER=edict
EDICT_PG_PASSWORD=CHANGE_ME
EDICT_PG_PORT=5432
EDICT_REDIS_PORT=6379

DATABASE_URL=postgresql+asyncpg://edict:CHANGE_ME@127.0.0.1:5432/edict
REDIS_URL=redis://127.0.0.1:6379/0

DISPATCH_TIMEOUT_SEC=300
HEARTBEAT_INTERVAL_SEC=30
SCHEDULER_SCAN_INTERVAL_SECONDS=60
STALL_THRESHOLD_SEC=180
MAX_DISPATCH_RETRY=3
DEBUG=false
