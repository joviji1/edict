[Unit]
Description=edict backend infra (postgres + redis)
After=docker.service network-online.target
Wants=docker.service network-online.target
PartOf=edict-backend-stack.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
WorkingDirectory=/root/.openclaw/workspace/edict
EnvironmentFile=-/etc/edict/backend.env
ExecStart=/usr/bin/bash /root/.openclaw/workspace/edict/scripts/manage_backend_infra.sh up
ExecStop=/usr/bin/bash /root/.openclaw/workspace/edict/scripts/manage_backend_infra.sh down
TimeoutStartSec=180
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
